<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reaching the people you follow, and nothing else. No location, no
         Bluetooth, no SMS: a follower talks to a network and draws a line. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      CHANGE_WIFI_MULTICAST_STATE — so that mDNS can actually receive.
      **THE LEG OF DISCOVERY THAT ANDROID SWITCHES OFF BY DEFAULT.** p2panda
      spawns `MdnsDiscovery` in `Active` mode, and its own comment warns that
      without a mode "two peers on the same wifi never see each other". On
      Android there is a second switch: the wifi chip drops multicast to userspace
      unless an app holds a `MulticastLock`, and holding one needs this
      permission. So mDNS was running and hearing nothing.

      It cost a night to find. Two phones on one wifi, the subject's phone slept
      and came back on a new address, and the follower could no longer resolve
      its node id to anywhere — the relay leg was not connected either, so there
      was no route left at all. Both vaults went dark together, which is what
      said it was transport rather than storage.

      It is not an internet permission. It changes nothing about what leaves the
      phone; it lets this app receive the multicast the wifi chip is already
      seeing.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      FOREGROUND_SERVICE (+ SPECIAL_USE) and POST_NOTIFICATIONS — so that
      "keep up to date while asleep" can actually do it.

      **THE PHONE NAMED THESE.** `dumpsys netpolicy` reports a sleeping app as
      `blocked_state={effective=DOZE|APP_BACKGROUND}`, and a foreground service
      is what clears `APP_BACKGROUND`. A `WifiLock` was tried first and does
      nothing: the radio is up the whole time, it is the app that is denied.

      The notification is required by Android and is right anyway — an app
      holding a network connection open while somebody sleeps should be visible
      in the shade, and stoppable from there.

      All three are inert unless the user turns the setting on. Off, this app
      runs exactly as it did: fetching when opened, and on whatever cadence
      Android allows in between.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- NOT `FOREGROUND_SERVICE_DATA_SYNC`, AND THE REASON COST A NIGHT.
         Android 15 time-limits a `dataSync` foreground service to about six
         hours in any twenty-four: at the limit the system kills the process,
         and every restart after that is refused until somebody opens the app.
         Measured on 2026-09-15 — started 21:25, killed 03:37:54, still dead at
         07:05. For an app whose whole job is to be watching while nobody is
         looking, that is the use case failing silently every night.
         `specialUse` carries no such limit. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scanning an invite. Optional: an invite can be pasted as text. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- FOUR MORE ARRIVE BY MERGE, and the shipped app asks for seven. Anyone
         reading only the three above will be surprised by the list F-Droid
         prints, so it is written down here:

           WAKE_LOCK, RECEIVE_BOOT_COMPLETED, FOREGROUND_SERVICE
               from androidx.work:work-runtime. WorkManager holds a wakelock
               while a worker runs, and RECEIVE_BOOT_COMPLETED is how it puts
               the fifteen-minute sync back after a reboot — without it a
               restart stops the syncing silently and the next reading you see
               looks current and is hours old, which is the failure this app
               exists to make visible.
           ${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION
               generated by androidx.core for its own non-exported receivers.

         FOREGROUND_SERVICE used to be listed here as the one that was NOT
         used — WorkManager declares it for expedited work and nothing called
         setExpedited. That is no longer true: this app declares it itself,
         above, for the stay-awake service, and dropping it would now break the
         only thing that keeps a follower current while the screen is off. The
         note is kept rather than deleted because it was right for months and
         somebody reading an old build will remember it. -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Follower">
        <!-- Declared `specialUse`, not `dataSync`, because `dataSync` is
             time-limited to six hours and this must survive a night. Exported
             false — nothing outside this app has any business starting it. -->
        <!-- Puts the service back after a reboot or an update. Without this,
             "keep up to date while asleep" silently stops meaning anything the
             moment the app is updated, until somebody opens it. RECEIVE_BOOT_
             COMPLETED already arrives by merge from WorkManager. -->
        <receiver
            android:name=".Restart"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".StayAwake"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Reviewed by Google Play for apps shipped through it; ayni is
                 not. The text is here because it is true and because somebody
                 reading the manifest deserves to know what the service is for,
                 not because a store asked. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a peer-to-peer connection so a glucose reading arrives while the screen is off. There is no server to poll: readings are pushed by the phone that produced them, so the connection has to be held rather than re-established on a timer." />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
