# A diaswarm pool member, as a systemd USER service.
#
#   mkdir -p ~/.config/systemd/user
#   cp diaswarm-peer.service ~/.config/systemd/user/
#   systemctl --user enable --now diaswarm-peer
#   journalctl --user -fu diaswarm-peer
#
# A USER unit, not a system one, and that is deliberate: this holds a share of
# other people's sealed records and needs no privilege whatsoever. It reads and
# writes one directory under your own home. Nothing here should ever want root.
#
# ON A HEADLESS MACHINE, run `loginctl enable-linger $USER` as well, or systemd
# stops your user's services when you log out — which on a server is most of the
# time, and would make an "always-on" carrier one that runs while you are ssh'd
# in. That is the single most likely way this gets silently misconfigured.

[Unit]
Description=diaswarm pool peer — carries sealed records it cannot read
Documentation=https://github.com/alex-poor/diaswarm
# Do not race the network on boot; the peer retries anyway, but a first pass
# that fails for want of a route is a confusing first log line.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/diaswarm-peer
Restart=on-failure
RestartSec=30s

# A LEAK MUST RESTART THE PEER, NOT THE DESKTOP.
#
# Measured 2026-09-16: this service reached 8.2 GB anon plus 4.3 million swap
# entries and the kernel's OOM killer fired. `OOMScoreAdjust` steered it at the
# peer rather than at the compositor, which worked — but an editor went as
# collateral and swap had already filled to 46 GB, so the machine was crawling
# long before anything was killed. An unbounded carrier can take the desktop
# with it.
#
# A carrier holding other people's ciphertext has no business using gigabytes:
# steady state after catch-up is 50–350 MB, and the transient for one
# re-subscribe peaks around 750 MB. 2 GB is generous against that and decisive
# against a runaway.
#
# **BOTH, NOT EITHER.** `MemoryHigh` only throttles and lets the process swap the
# machine to death first, which is exactly what happened; `MemoryMax` is the hard
# ceiling. High starts reclaim early, Max ends it.
MemoryHigh=1G
MemoryMax=2G

# THE SAME DIRECTORY THE BINARY USES WHEN RUN BY HAND. An earlier version of
# this file pointed the service at `%S` (~/.local/state) while
# `diaswarm-peer` with no arguments defaults to ~/.local/share — so running it
# both ways would have built two stores with two node identities, and the pool
# would have seen two peers where there is one machine. Say the path once.
Environment=XDG_DATA_HOME=%h/.local/share

# IT CARRIES STRANGERS' CIPHERTEXT, SO GIVE IT AS LITTLE AS POSSIBLE. None of
# this is required for it to work; all of it is cheap. If a line here ever
# stops the peer starting, delete that line rather than the sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The one place it may write. Must exist before the service starts.
ReadWritePaths=%h/.local/share/diaswarm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
